{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "msa-trainer/content/v2",
  "title": "MSA Trainer content pack v2",
  "definitions": {
    "subject": { "type": "string", "enum": ["MATH", "DE", "EN"] },
    "topic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "subject", "code", "name", "parentId"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
        "subject": { "$ref": "#/definitions/subject" },
        "code": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "parentId": { "type": ["string", "null"] },
        "description": { "type": "string" }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "body"],
      "properties": {
        "kind": { "type": "string", "enum": ["what", "terms", "formula", "steps", "mistake", "remember", "answer", "example", "widget", "text"] },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "figure": { "$ref": "#/definitions/figure" },
        "figures": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["figure"],
            "properties": { "caption": { "type": "string" }, "figure": { "$ref": "#/definitions/figure" } }
          }
        },
        "primer": { "type": "string", "pattern": "^P_[A-Z][A-Za-z0-9_]+$" }
      }
    },
    "primer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "subject", "title", "teaser", "hook", "steps", "vocab", "quiz"],
      "properties": {
        "id": { "type": "string", "pattern": "^P_[A-Z][A-Za-z0-9_]+$" },
        "subject": { "$ref": "#/definitions/subject" },
        "title": { "type": "string", "minLength": 1 },
        "teaser": { "type": "string", "minLength": 1 },
        "hook": { "type": "string", "minLength": 1 },
        "outro": { "type": "string" },
        "steps": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "body"],
            "properties": { "title": { "type": "string", "minLength": 1 }, "body": { "type": "string", "minLength": 1 }, "figure": { "$ref": "#/definitions/figure" }, "say": { "type": "string" } }
          }
        },
        "vocab": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["term", "plain"],
            "properties": { "term": { "type": "string", "minLength": 1 }, "plain": { "type": "string", "minLength": 1 }, "example": { "type": "string" } }
          }
        },
        "quiz": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["prompt", "choices", "correct", "explain"],
            "properties": {
              "prompt": { "type": "string", "minLength": 1 },
              "choices": { "type": "array", "minItems": 2, "maxItems": 5, "items": { "type": "string", "minLength": 1 } },
              "correct": { "type": "string", "minLength": 1 },
              "explain": { "type": "string", "minLength": 1 }
            }
          }
        },
        "source": { "type": "string" }
      }
    },
    "figure": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["rightTriangle", "triangle", "rectangle", "parallelogram", "trapezoid", "circle", "coordinateSystem", "barChart", "pieChart", "treeDiagram", "box", "cylinder", "angle", "pyramid", "cone", "sphere"] }
      }
    },
    "explanation": {
      "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/section" } }]
    },
    "variable": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "min", "max"],
          "properties": { "type": { "const": "int" }, "min": { "type": "integer" }, "max": { "type": "integer" }, "step": { "type": "integer", "minimum": 1 } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "min", "max", "step"],
          "properties": { "type": { "const": "float" }, "min": { "type": "number" }, "max": { "type": "number" }, "step": { "type": "number", "exclusiveMinimum": 0 } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "values"],
          "properties": { "type": { "const": "choice" }, "values": { "type": "array", "minItems": 1, "items": { "type": ["string", "number"] } } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "from"],
          "properties": {
            "type": { "const": "pick" },
            "from": { "type": "array", "minItems": 2, "items": { "type": "object", "minProperties": 1, "additionalProperties": { "type": ["string", "number"] } } }
          }
        }
      ]
    },
    "variants": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "variables"],
      "properties": {
        "enabled": { "type": "boolean" },
        "variables": { "type": "object", "additionalProperties": { "$ref": "#/definitions/variable" } },
        "derived": { "type": "object", "additionalProperties": { "type": "string" } },
        "constraints": { "type": "array", "items": { "type": "string" } }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "subject", "topicId", "difficulty", "qtype", "prompt", "payload", "solution", "explanation", "tags"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9_]+$" },
        "subject": { "$ref": "#/definitions/subject" },
        "topicId": { "type": "string" },
        "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
        "qtype": { "type": "string", "enum": ["MCQ", "CLOZE", "MATCH", "SHORT", "WRITE"] },
        "prompt": { "type": "string", "minLength": 1 },
        "payload": { "type": "object" },
        "solution": { "type": "object" },
        "explanation": { "$ref": "#/definitions/explanation" },
        "tags": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "variants": { "$ref": "#/definitions/variants" },
        "source": { "type": "string" },
        "figure": { "oneOf": [{ "type": "string" }, { "$ref": "#/definitions/figure" }] },
        "passage": { "type": "string", "pattern": "^X_[A-Z][A-Za-z0-9_]+$" }
      }
    },
    "passage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "subject", "title", "body"],
      "properties": {
        "id": { "type": "string", "pattern": "^X_[A-Z][A-Za-z0-9_]+$" },
        "subject": { "$ref": "#/definitions/subject" },
        "title": { "type": "string", "minLength": 1 },
        "body": { "type": "string", "minLength": 1 },
        "source": { "type": "string" }
      }
    },
    "lesson": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "subject", "topicId", "title", "sections"],
      "properties": {
        "id": { "type": "string", "pattern": "^L_[A-Z][A-Za-z0-9_]+$" },
        "subject": { "$ref": "#/definitions/subject" },
        "topicId": { "type": "string" },
        "alsoFor": { "type": "array", "items": { "type": "string" } },
        "title": { "type": "string", "minLength": 1 },
        "intro": { "type": "string" },
        "sections": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/section" } },
        "source": { "type": "string" },
        "primer": { "type": "string", "pattern": "^P_[A-Z][A-Za-z0-9_]+$" }
      }
    }
  },
  "type": "object",
  "properties": {
    "topics": { "type": "array", "items": { "$ref": "#/definitions/topic" } },
    "questions": { "type": "array", "items": { "$ref": "#/definitions/question" } },
    "lessons": { "type": "array", "items": { "$ref": "#/definitions/lesson" } },
    "primers": { "type": "array", "items": { "$ref": "#/definitions/primer" } },
    "passages": { "type": "array", "items": { "$ref": "#/definitions/passage" } }
  }
}
