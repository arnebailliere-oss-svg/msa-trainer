  {
    "id": "MATH_PROB_URNE_T1",
    "subject": "MATH",
    "topicId": "MATH_DATA_PROB",
    "difficulty": 2,
    "qtype": "SHORT",
    "prompt": "In einer Urne sind {{b}} blaue, {{r}} rote und {{g}} grüne Kugeln. Eine Kugel wird zufällig gezogen. Wie groß ist die Wahrscheinlichkeit für eine **grüne** Kugel? (Bruch, vollständig gekürzt)",
    "payload": {
      "answer_type": "fraction",
      "require_reduced": true
    },
    "solution": {
      "value": "{{= g/(b+r+g) | frac}}"
    },
    "explanation": [
      {
        "kind": "formula",
        "body": "$P(E) = \\frac{\\text{günstige}}{\\text{alle}}$"
      },
      {
        "kind": "steps",
        "body": "1. Alle Kugeln: ${{b}} + {{r}} + {{g}} = {{= b+r+g}}$\n2. Günstig (grün): {{g}}\n3. $P(\\text{grün}) = \\frac{{{g}}}{{{= b+r+g}}} = {{= g/(b+r+g) | fractex}} \\approx {{= g/(b+r+g)*100 | fixed:1}}\\,\\%$"
      },
      {
        "kind": "answer",
        "body": "${{= g/(b+r+g) | fractex}}$"
      }
    ],
    "tags": [
      "stochastik",
      "laplace",
      "drill"
    ],
    "source": "Verallgemeinert nach Prüfungshefte 2027, 3.1 Aufgabe 4a",
    "variants": {
      "enabled": true,
      "variables": {
        "b": {
          "type": "int",
          "min": 1,
          "max": 8
        },
        "r": {
          "type": "int",
          "min": 1,
          "max": 8
        },
        "g": {
          "type": "int",
          "min": 1,
          "max": 8
        }
      },
      "constraints": [
        "b != g",
        "r != g"
      ]
    }
  },
