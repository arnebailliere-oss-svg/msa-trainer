    "explanation": [
      {
        "kind": "steps",
        "body": "$x = x + 1 \\quad | - x$\n\n$0 = 1$ — das ist **falsch**, egal welchen Wert $x$ hat. Also gibt es keine Lösung: $L = \\{\\}$."
      },
      {
        "kind": "remember",
        "body": "Fällt $x$ weg und bleibt eine **falsche** Aussage ($0 = 1$) → keine Lösung. Bleibt eine **wahre** Aussage ($0 = 0$) → alle Zahlen sind Lösung."
      },
      {
        "kind": "answer",
        "body": "$L = \\{\\}$"
      }
    ],
