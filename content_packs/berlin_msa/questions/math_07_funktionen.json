    "prompt": "Berechne die Nullstelle der linearen Funktion $y = {{m}}x {{= n | sign}}$.",
    "payload": {
      "answer_type": "number"
    },
    "solution": {
      "kind": "computed",
      "expr": "-n / m"
    },
    "explanation": [
      {
        "kind": "what",
        "body": "Nullstelle = der $x$-Wert, an dem der Graph die $x$-Achse schneidet. Dort ist $y = 0$."
      },
      {
        "kind": "steps",
        "body": "${{m}}x {{= n | sign}} = 0 \\;|\\; {{= -n | sign}}$\n\n${{m}}x = {{= -n}} \\;|\\; : {{m}}$\n\n$x = {{= -n/m}}$\n\nDie Nullstelle liegt bei $x = {{= -n/m}}$, also im Punkt $({{= -n/m}} \\,|\\, 0)$."
      },
      {
        "kind": "answer",
        "body": "$x = {{= -n/m}}$"
      }
