  {
    "id": "MATH_GEO_PARALLELOGRAMM_MCQ_T1",
    "subject": "MATH",
    "topicId": "MATH_GEO_AREA_BASIC",
    "difficulty": 2,
    "qtype": "MCQ",
    "prompt": "Ein Parallelogramm hat die Grundseite $a = {{a}}$ cm, die schräge Seite $b = {{b}}$ cm und die Höhe $h = {{h}}$ cm. Wie groß ist der Flächeninhalt?",
    "payload": {
      "choices": [
        "{{= a*h}} cm²",
        "{{= a*b}} cm²",
        "{{= a*h/2}} cm²",
        "{{= 2*a + 2*b}} cm²"
      ],
      "shuffle": true
    },
    "solution": {
      "correct_choice": "{{= a*h}} cm²"
    },
    "explanation": [
      {
        "kind": "formula",
        "body": "$A = a \\cdot h$ — Grundseite mal **Höhe**. Die schräge Seite $b$ spielt für die Fläche keine Rolle."
      },
      {
        "kind": "steps",
        "body": "$A = {{a}} \\cdot {{h}} = {{= a*h}}\\,\\text{cm}^2$"
      },
      {
        "kind": "mistake",
        "body": "${{a}} \\cdot {{b}} = {{= a*b}}$ ist der Klassiker — die Höhe steht **senkrecht** auf der Grundseite, die schräge Seite nicht."
      },
      {
        "kind": "answer",
        "body": "{{= a*h}} cm²"
      }
    ],
    "tags": [
      "geometrie",
      "parallelogramm",
      "flaeche",
      "drill"
    ],
    "variants": {
