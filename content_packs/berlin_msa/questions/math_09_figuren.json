  {
    "id": "MATH_GEO_RECHTECK_FLAECHE_T1",
    "subject": "MATH",
    "topicId": "MATH_GEO_AREA_BASIC",
    "difficulty": 2,
    "qtype": "SHORT",
    "prompt": "Ein Rechteck hat die Seiten $a = {{a}}$ cm und $b = {{b}}$ dm. Berechne den Flächeninhalt in dm².",
    "payload": {
      "answer_type": "number",
      "unit": "dm²",
      "tolerance": 0.01
    },
    "solution": {
      "kind": "computed",
      "expr": "a / 10 * b",
      "round": 2
    },
    "explanation": [
      {
        "kind": "what",
        "body": "Zwei verschiedene Einheiten — **erst umrechnen**, dann rechnen. Gefragt ist dm², also $a$ in dm."
      },
      {
        "kind": "steps",
        "body": "1. $a = {{a}}$ cm $= {{= a/10}}$ dm\n2. $A = a \\cdot b = {{= a/10}} \\cdot {{b}} = {{= a/10*b}}\\,\\text{dm}^2$"
      },
      {
        "kind": "mistake",
        "body": "${{a}} \\cdot {{b}} = {{= a*b}}$ wäre falsch — cm mal dm ergibt keine sinnvolle Einheit."
      },
      {
        "kind": "answer",
        "body": "{{= a/10*b}} dm²"
      }
    ],
