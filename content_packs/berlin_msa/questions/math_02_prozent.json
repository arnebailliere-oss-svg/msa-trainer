    "difficulty": 1,
    "qtype": "SHORT",
    "prompt": "Gib {{= n/100}} in Prozent an.",
    "payload": {
      "answer_type": "number",
      "unit": "%"
    },
    "solution": {
      "kind": "computed",
      "expr": "n"
    },
    "explanation": [
      {
        "kind": "what",
        "body": "Prozent heißt „von Hundert“. Eine Dezimalzahl wird zu Prozent, indem man sie **mal 100** nimmt — das Komma wandert zwei Stellen nach rechts."
      },
      {
        "kind": "steps",
        "body": "${{= n/100}} = \\frac{{{n}}}{100} = {{n}}\\,\\%$"
      },
      {
        "kind": "mistake",
        "body": "Bei Zahlen über 1 gibt es mehr als 100 %: $1{,}74 = 174\\,\\%$. Das ist völlig normal, z. B. bei Preissteigerungen."
      },
      {
        "kind": "answer",
        "body": "{{n}} %"
      }
    ],
    "tags": [
