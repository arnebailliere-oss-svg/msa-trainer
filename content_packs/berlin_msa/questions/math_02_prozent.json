      },
      {
        "kind": "steps",
        "body": "$\\frac{{{a}}}{{{b}}} = \\frac{{{a}} \\cdot {{= 100/b}}}{{{b}} \\cdot {{= 100/b}}} = \\frac{{{= a*100/b}}}{100} = {{= a*100/b}}\\,\\%$\n\nOder: ${{a}} : {{b}} = {{= a/b}}$, und ${{= a/b}} \\cdot 100 = {{= a*100/b}}\\,\\%$"
      },
      {
        "kind": "answer",
        "body": "{{= a*100/b}} %"
      }
